---
interface Props {
  title: string;
}
const { title } = Astro.props;
import '../styles/global.css';
import TopBar from '../components/TopBar.astro'; // 1. 导入
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.jpg">
    <title>{title}</title>
    <!-- 引入简单的重置样式 -->
    <style is:global>
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
      a { text-decoration: none; color: inherit; }
      
      /* 顶部 Header 样式 */
      .top-bar { display: flex; justify-content: space-between; align-items: center; padding: 15px 40px; }
      .search-box { flex-grow: 1; max-width: 600px; position: relative; }
      .search-box input { width: 100%; padding: 12px 20px; border-radius: 30px; border: 1px solid #ddd; outline: none; }
      
      .auth-buttons { display: flex; gap: 15px; align-items: center; }
      .btn-promo { background-color: #ff4757; color: white; padding: 10px 20px; border-radius: 20px; font-weight: bold; font-size: 0.9rem; }
      .btn-tutorial { border: 1px solid #ddd; padding: 10px 20px; border-radius: 20px; background: white; }

      /* 分类导航条 */
      .category-nav { display: flex; justify-content: center; gap: 10px; padding: 20px 0; overflow-x: auto; }
      .cat-pill { padding: 8px 20px; border-radius: 20px; background: white; border: 1px solid #eee; cursor: pointer; white-space: nowrap; font-size: 0.9rem; transition: 0.2s; }
      .cat-pill:hover, .cat-pill.active { background: #333; color: white; border-color: #333; }
      
      /* 主容器 */
      .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
    </style>
  </head>
  <body>
    <!-- 顶部区域 -->
     <TopBar /> 
     <slot />
  </body>
</html>