<style>
  /* 全局容器宽度控制 */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- 顶部公告栏样式 --- */
  .top-announcement {
    background-color: #0f0f0f; /* 非常深的背景色 */
    color: #888; /* 灰色文字 */
    font-size: 12px;
    padding: 8px 0;
    text-align: center;
    border-bottom: 1px solid #222;
  }

  .top-announcement strong {
    color: #ccc; /* 名字稍微亮一点 */
    font-weight: 600;
  }

  .highlight-link {
    color: #a5b4fc; /* 淡紫色高亮，类似截图 */
    text-decoration: none;
  }

  /* --- 主导航栏样式 --- */
  .main-header {
    background-color: #000; /* 纯黑背景 */
    padding: 20px 0;
    border-bottom: 1px solid #222;
  }

  .header-content {
    display: flex;
    justify-content: space-between; /* 左中右分布 */
    align-items: center;
  }

  /* Logo */
  .logo {
    font-size: 20px;
    font-weight: 800;
    color: #fff;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* 中间菜单 */
  .nav-links {
    display: flex;
    gap: 30px;
    background: #1a1a1a; /* 深灰色胶囊背景 */
    padding: 8px 20px;
    border-radius: 999px; /* 圆角 */
  }

  .nav-links a {
    color: #888;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #fff; /* 悬停变白 */
  }

  /* 右侧链接 */
  .social-links {
    display: flex;
    gap: 20px;
  }

  .social-links a {
    color: #888;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  .social-links a:hover {
    color: #fff;
  }

  /* 移动端简单适配 (可选) */
  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      gap: 15px;
    }
    .nav-links {
      width: 100%;
      justify-content: center;
    }
  }
</style>