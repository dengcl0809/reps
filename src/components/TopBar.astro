<!-- 2. 主导航栏 -->
<header class="main-header">
  <div class="container header-content">
    <!-- 左侧 Logo -->
    <div class="logo">Akraaf</div>

    <!-- 中间 导航菜单 -->
    <nav class="nav-links">
      <a href="/" class="active">Home</a>
      <a href="https://navo-store.x.yupoo.com/albums/235687180?uid=1&isSubCate=false&referrercate=5208620"  target="_blank">How to Buy</a>
